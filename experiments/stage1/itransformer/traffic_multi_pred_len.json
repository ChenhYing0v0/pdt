{
  "baseline": "itransformer",
  "stage": "stage1_backbone_init",
  "dataset": "Traffic",
  "seq_len": 96,
  "pred_len": [96, 192, 336, 720],
  "seed": 2026,
  "search_budget": {
    "trials": 1,
    "policy": "fixed_reproduction"
  },
  "entry": "baselines/itransformer/run.py",
  "args": {
    "data": "custom",
    "root_path": "${DATA_ROOT}/traffic/",
    "data_path": "traffic.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 862,
    "dec_in": 862,
    "c_out": 862,
    "d_model": [512, 512, 512, 512],
    "d_ff": [512, 512, 512, 512],
    "e_layers": [4, 4, 4, 4],
    "batch_size": [16, 16, 16, 16],
    "learning_rate": 0.001,
    "train_epochs": 10,
    "patience": 3,
    "itr": 1,
    "model": "iTransformer",
    "des": "PDTInit"
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse"
}
