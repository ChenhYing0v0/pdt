{
  "baseline": "itransformer",
  "stage": "stage1_smoke",
  "dataset": "ETTh1",
  "seq_len": 96,
  "pred_len": 96,
  "seed": 2026,
  "search_budget": {
    "trials": 1,
    "policy": "smoke"
  },
  "entry": "baselines/itransformer/run.py",
  "args": {
    "data": "ETTh1",
    "root_path": "${DATA_ROOT}/ETT-small/",
    "data_path": "ETTh1.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 7,
    "dec_in": 7,
    "c_out": 7,
    "d_model": 256,
    "d_ff": 256,
    "e_layers": 2,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "train_epochs": 1,
    "patience": 1,
    "itr": 1,
    "num_workers": 0,
    "model": "iTransformer",
    "des": "PDTSmoke"
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse"
}
