{
  "baseline": "pdt",
  "stage": "stage1_backbone_init",
  "dataset": "Traffic",
  "seq_len": 96,
  "pred_len": [96],
  "seed": 2026,
  "search_budget": {
    "trials": 1,
    "policy": "fixed_reproduction"
  },
  "entry": "baselines/PDT/run.py",
  "args": {
    "data": "custom",
    "root_path": "${DATA_ROOT}/traffic/",
    "data_path": "traffic.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 862,
    "dec_in": 862,
    "c_out": 862,
    "d_model": 512,
    "d_ff": 512,
    "e_layers": 3,
    "batch_size": 32,
    "learning_rate": 0.0005,
    "train_epochs": 50,
    "patience": 5,
    "itr": 1,
    "model": "PDT",
    "q_mat_file": "dataset/RRR_mats/traffic/traffic_RRR_L96_R96_H96_Qin.npy",
    "q_out_mat_file": "dataset/PCCA_mats/traffic/traffic_PCCA_OUT_H96_identity_avg.npy",
    "r_mat_file": "dataset/RRR_mats/traffic/traffic_RRR_L96_R96_H96_R.npy",
    "rk_mat_file": "dataset/RRR_mats/traffic/traffic_RRR_L96_R16_H96_R.npy",
    "r_rank": 96,
    "k_top": 16,
    "embed_size": 16,
    "dropout": 0.0,
    "loss_mode": "L1",
    "rec_lambda": 1.0,
    "auxi_lambda": 0.0,
    "alpha_init": 0.1,
    "mask_threshold": 0.15,
    "des": "PDTInit"
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse"
}
