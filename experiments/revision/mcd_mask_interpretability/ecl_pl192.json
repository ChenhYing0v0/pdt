{
  "baseline": "pdt",
  "stage": "revision_mcd_mask_interpretability",
  "dataset": "ECL",
  "seq_len": 96,
  "pred_len": 192,
  "seed": 2023,
  "search_budget": {
    "trials": 1,
    "policy": "fixed_mask_interpretability_candidates"
  },
  "entry": "baselines/PDT/run.py",
  "args": {
    "data": "custom",
    "root_path": "${DATA_ROOT}/electricity/",
    "data_path": "electricity.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 321,
    "dec_in": 321,
    "c_out": 321,
    "d_model": 512,
    "d_ff": 512,
    "e_layers": 3,
    "d_layers": 1,
    "factor": 3,
    "batch_size": 32,
    "num_workers": 8,
    "learning_rate": 0.0005,
    "train_epochs": 50,
    "patience": 5,
    "lradj": "cosine",
    "itr": 1,
    "model": "PDT",
    "q_mat_file": "dataset/RRR_mats/electricity/electricity_RRR_L96_R96_H192_Qin.npy",
    "q_out_mat_file": "dataset/PCCA_mats/electricity/electricity_PCCA_OUT_H192_identity_avg.npy",
    "r_mat_file": "dataset/RRR_mats/electricity/electricity_RRR_L96_R96_H192_R.npy",
    "rk_mat_file": "dataset/RRR_mats/electricity/electricity_RRR_L96_R64_H192_R.npy",
    "r_rank": 96,
    "k_top": 64,
    "embed_size": 16,
    "dropout": 0.0,
    "loss_mode": "L1",
    "rec_lambda": 1.0,
    "auxi_lambda": 0.0,
    "Q_chan_indep": 0,
    "freeze_R": 0,
    "CKA_flag": 0,
    "alpha_init": 0.1,
    "mask_threshold": 0.05,
    "des": "MCDMaskPL192",
    "pred_len": 192
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse",
  "mask_interpretability": {
    "purpose": "candidate_for_main_text_series_representation_analysis",
    "pred_len": 192,
    "expected_outputs": [
      "metrics.json",
      "channel_mask.npy",
      "mask_stats.json"
    ]
  }
}
