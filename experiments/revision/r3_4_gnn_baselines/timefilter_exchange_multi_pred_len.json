{
  "baseline": "timefilter",
  "stage": "revision_r3_4_gnn_baseline",
  "dataset": "Exchange",
  "seq_len": 96,
  "pred_len": [
    96,
    192,
    336,
    720
  ],
  "seed": 2023,
  "search_budget": {
    "trials": 1,
    "policy": "timefilter_etth1_settings_for_exchange_l96"
  },
  "entry": "baselines/TimeFilter/run.py",
  "args": {
    "data": "custom",
    "root_path": "${DATA_ROOT}/exchange_rate/",
    "data_path": "exchange_rate.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 8,
    "dec_in": 8,
    "c_out": 8,
    "e_layers": 2,
    "d_layers": 1,
    "factor": 3,
    "patch_len": 2,
    "d_model": 128,
    "d_ff": [
      256,
      256,
      256,
      128
    ],
    "dropout": 0.8,
    "pos": 0,
    "learning_rate": 0.0001,
    "batch_size": 32,
    "train_epochs": 10,
    "patience": 3,
    "num_workers": 1,
    "itr": 1,
    "model": "TimeFilter",
    "des": "Exp"
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse"
}
