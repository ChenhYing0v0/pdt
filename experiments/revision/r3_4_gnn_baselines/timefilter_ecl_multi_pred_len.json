{
  "baseline": "timefilter",
  "stage": "revision_r3_4_gnn_baseline_verify",
  "dataset": "ECL",
  "seq_len": 96,
  "pred_len": [
    96,
    192,
    336,
    720
  ],
  "seed": 2023,
  "search_budget": {
    "trials": 1,
    "policy": "official_timefilter_ecl_l96_drop_last_true"
  },
  "entry": "baselines/TimeFilter/run.py",
  "args": {
    "data": "custom",
    "root_path": "${DATA_ROOT}/electricity/",
    "data_path": "electricity.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 321,
    "dec_in": 321,
    "c_out": 321,
    "e_layers": 2,
    "d_layers": 1,
    "factor": 3,
    "patch_len": 32,
    "d_model": 512,
    "d_ff": 512,
    "dropout": [
      0.5,
      0.4,
      0.4,
      0.4
    ],
    "learning_rate": 0.001,
    "batch_size": 16,
    "train_epochs": 15,
    "patience": 3,
    "num_workers": 1,
    "itr": 1,
    "model": "TimeFilter",
    "des": "Exp"
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse"
