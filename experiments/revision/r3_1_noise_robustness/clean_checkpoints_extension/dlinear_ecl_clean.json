{
  "baseline": "dlinear",
  "stage": "revision_r3_1_clean_checkpoint_extension",
  "dataset": "ECL",
  "seq_len": 96,
  "pred_len": [
    96,
    192,
    336,
    720
  ],
  "seed": 2023,
  "search_budget": {
    "trials": 1,
    "policy": "fixed_reproduction"
  },
  "entry": "baselines/PDT/run.py",
  "args": {
    "data": "custom",
    "root_path": "${DATA_ROOT}/electricity/",
    "data_path": "electricity.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 321,
    "dec_in": 321,
    "c_out": 321,
    "moving_avg": 25,
    "individual": 0,
    "batch_size": 32,
    "num_workers": 8,
    "learning_rate": 0.005,
    "train_epochs": 10,
    "patience": 3,
    "lradj": "type1",
    "itr": 1,
    "model": "DLinear",
    "loss_mode": "L2",
    "des": "R3_1CleanExt"
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse"
}
