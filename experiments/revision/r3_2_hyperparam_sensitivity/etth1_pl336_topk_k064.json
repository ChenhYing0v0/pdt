{
  "baseline": "pdt",
  "stage": "revision_r3_2_hyperparam_sensitivity",
  "dataset": "ETTh1",
  "seq_len": 96,
  "pred_len": 336,
  "seed": 2023,
  "search_budget": {
    "trials": 1,
    "policy": "fixed_reviewer_sensitivity"
  },
  "entry": "baselines/PDT/run.py",
  "args": {
    "data": "ETTh1",
    "root_path": "${DATA_ROOT}/ETT-small/",
    "data_path": "ETTh1.csv",
    "features": "M",
    "target": "OT",
    "freq": "h",
    "seq_len": 96,
    "label_len": 48,
    "enc_in": 7,
    "dec_in": 7,
    "c_out": 7,
    "d_model": 512,
    "d_ff": 512,
    "e_layers": 2,
    "d_layers": 1,
    "factor": 3,
    "batch_size": 32,
    "num_workers": 8,
    "learning_rate": 0.0005,
    "train_epochs": 30,
    "patience": 8,
    "lradj": "type1",
    "itr": 1,
    "model": "PDT",
    "q_mat_file": "dataset/RRR_mats/ETTh1/ETTh1_RRR_L96_R96_H336_Qin.npy",
    "q_out_mat_file": "dataset/PCCA_mats/ETTh1/ETTh1_PCCA_OUT_H336_identity_avg.npy",
    "r_mat_file": "dataset/RRR_mats/ETTh1/ETTh1_RRR_L96_R96_H336_R.npy",
    "rk_mat_file": "dataset/RRR_mats/ETTh1/ETTh1_RRR_L96_R64_H336_R.npy",
    "r_rank": 96,
    "k_top": 64,
    "embed_size": 16,
    "dropout": 0.2,
    "loss_mode": "L1",
    "rec_lambda": 1.0,
    "auxi_lambda": 0.0,
    "Q_chan_indep": 0,
    "freeze_R": 0,
    "CKA_flag": 0,
    "alpha_init": 0.05,
    "mask_threshold": 0.05,
    "des": "R32TopK064",
    "pred_len": 336
  },
  "env": {
    "DATA_ROOT": "${DATA_ROOT}",
    "CUDA_VISIBLE_DEVICES": "0"
  },
  "metric_policy": "forecasting_v1",
  "selection_policy": "best_val_mse",
  "sensitivity": {
    "axis": "topk",
    "value": 64,
    "default_k_top": 64,
    "default_mask_threshold": 0.05,
    "pred_len": 336
  }
